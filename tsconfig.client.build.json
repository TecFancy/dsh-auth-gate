{
  "extends": "./tsconfig.client.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    // Same reason as tsconfig.build.json: `src/` is not shipped, so a
    // declaration map would reference files the consumer cannot open.
    "declarationMap": false,
    "newLine": "lf",
    "rootDir": "src",
    "outDir": "lib"
  },
  "include": ["src/client"],
  "exclude": ["src/client/**/*.test.ts", "src/client/**/*.test.tsx"]
}
